import Math

struct QuantumState {
    var numQubits: int
    var numStates: int
    var amplitudes: Array<Complex>

    init(numQubits: int) {
        precondition(numQubits >= 1 && numQubits <= 20, "QuantumState requires 1...20 qubits")
        let count = 1 << numQubits
        let zero = Complex(real: 0.0, imag: 0.0)
        var initial = Array<Complex>(repeating: zero, count: count)
        initial[0] = Complex(real: 1.0, imag: 0.0)
        self.numQubits = numQubits
        self.numStates = count
        self.amplitudes = initial
    }
}

implementation QuantumState {
    mutating fn applyUnitary(self, _ targetQubit: int, _ controlMask: int, _ u00: Complex, _ u01: Complex, _ u10: Complex, _ u11: Complex) {
        precondition(targetQubit >= 0 && targetQubit < self.numQubits, "targetQubit out of bounds")
        let count = self.numStates
        let bitMask = 1 << targetQubit
        let invBitMask = ~bitMask
        precondition((controlMask & bitMask) == 0, "controlMask must not include targetQubit")

        let zero = Complex(real: 0.0, imag: 0.0)
        var nextAmplitudes = Array<Complex>(repeating: zero, count: count)

        for stateIndex in 0..<count {
            if (stateIndex & controlMask) != controlMask {
                nextAmplitudes[stateIndex] = self.amplitudes[stateIndex]
            } else {
                let zeroPartner = stateIndex & invBitMask
                let onePartner = stateIndex | bitMask
                let amp0 = self.amplitudes[zeroPartner]
                let amp1 = self.amplitudes[onePartner]
                if (stateIndex & bitMask) == 0 {
                    nextAmplitudes[stateIndex] = u00 * amp0 + u01 * amp1
                } else {
                    nextAmplitudes[stateIndex] = u10 * amp0 + u11 * amp1
                }
            }
        }

        self.amplitudes = nextAmplitudes
    }

    mutating fn applySwap(self, _ qubitA: int, _ qubitB: int, _ controlMask: int) {
        precondition(qubitA >= 0 && qubitA < self.numQubits, "qubitA out of bounds")
        precondition(qubitB >= 0 && qubitB < self.numQubits, "qubitB out of bounds")
        if qubitA == qubitB {
            return
        }

        let count = self.numStates
        let flipMask = (1 << qubitA) | (1 << qubitB)
        precondition((controlMask & flipMask) == 0, "controlMask must not overlap SWAP target qubits")

        let zero = Complex(real: 0.0, imag: 0.0)
        var nextAmplitudes = Array<Complex>(repeating: zero, count: count)

        for stateIndex in 0..<count {
            if (stateIndex & controlMask) != controlMask {
                nextAmplitudes[stateIndex] = self.amplitudes[stateIndex]
            } else {
                let bitA = (stateIndex >> qubitA) & 1
                let bitB = (stateIndex >> qubitB) & 1
                if bitA == bitB {
                    nextAmplitudes[stateIndex] = self.amplitudes[stateIndex]
                } else {
                    nextAmplitudes[stateIndex] = self.amplitudes[stateIndex ^ flipMask]
                }
            }
        }

        self.amplitudes = nextAmplitudes
    }

    mutating fn applyPhaseOracle(self, _ markedState: int) {
        precondition(markedState >= 0 && markedState < self.numStates, "markedState out of bounds")
        let count = self.numStates
        let zero = Complex(real: 0.0, imag: 0.0)
        var nextAmplitudes = Array<Complex>(repeating: zero, count: count)

        for stateIndex in 0..<count {
            let amp = self.amplitudes[stateIndex]
            if stateIndex == markedState {
                nextAmplitudes[stateIndex] = -amp
            } else {
                nextAmplitudes[stateIndex] = amp
            }
        }

        self.amplitudes = nextAmplitudes
    }

    mutating fn applyGate(self, _ gate: QuantumGate) {
        match gate.kind {
        case .swap:
            self.applySwap(gate.targetQubit, gate.secondTargetQubit, gate.controlMask)
        case .phaseOracle(let markedState):
            self.applyPhaseOracle(markedState)
        default:
            let u00 = gate.kind.matrixRow0Col0()
            let u01 = gate.kind.matrixRow0Col1()
            let u10 = gate.kind.matrixRow1Col0()
            let u11 = gate.kind.matrixRow1Col1()
            self.applyUnitary(gate.targetQubit, gate.controlMask, u00, u01, u10, u11)
        }
    }

    fn probabilities(self) -> Array<double> {
        let count = self.numStates
        var probs = Array<double>(repeating: 0.0, count: count)
        for stateIndex in 0..<count {
            probs[stateIndex] = self.amplitudes[stateIndex].normSquared()
        }
        return probs
    }

    fn probabilityOf(self, _ stateIndex: int) -> double {
        precondition(stateIndex >= 0 && stateIndex < self.numStates, "stateIndex out of bounds")
        return self.amplitudes[stateIndex].normSquared()
    }

    fn totalProbability(self) -> double {
        var total = 0.0
        for stateIndex in 0..<self.numStates {
            total += self.amplitudes[stateIndex].normSquared()
        }
        return total
    }

    fn qubitProbabilityOne(self, _ qubit: int) -> double {
        precondition(qubit >= 0 && qubit < self.numQubits, "qubit out of bounds")
        let bitMask = 1 << qubit
        var total = 0.0
        for stateIndex in 0..<self.numStates {
            let term = if (stateIndex & bitMask) != 0 {
                self.amplitudes[stateIndex].normSquared()
            } else {
                0.0
            }
            total += term
        }
        return total
    }

    fn expectationZ(self, _ qubit: int) -> double {
        precondition(qubit >= 0 && qubit < self.numQubits, "qubit out of bounds")
        let bitMask = 1 << qubit
        var expectation = 0.0
        for stateIndex in 0..<self.numStates {
            let prob = self.amplitudes[stateIndex].normSquared()
            let sign = if (stateIndex & bitMask) == 0 { 1.0 } else { -1.0 }
            expectation += sign * prob
        }
        return expectation
    }

    fn innerProduct(self, _ other: QuantumState) -> Complex {
        precondition(self.numStates == other.numStates, "innerProduct requires states with equal qubit count")
        let count = self.numStates
        let zero = Complex(real: 0.0, imag: 0.0)
        var terms = Array<Complex>(repeating: zero, count: count)
        for stateIndex in 0..<count {
            terms[stateIndex] = self.amplitudes[stateIndex].conjugate() * other.amplitudes[stateIndex]
        }

        var sum = Complex(real: 0.0, imag: 0.0)
        for stateIndex in 0..<count {
            sum = sum + terms[stateIndex]
        }
        return sum
    }

    fn fidelity(self, _ other: QuantumState) -> double {
        return self.innerProduct(other).normSquared()
    }

    fn mostLikelyState(self) -> int {
        var bestIndex = 0
        var bestProb = -1.0
        for stateIndex in 0..<self.numStates {
            let prob = self.amplitudes[stateIndex].normSquared()
            if prob > bestProb {
                bestProb = prob
                bestIndex = stateIndex
            }
        }
        return bestIndex
    }

    fn duplicate(self) -> QuantumState {
        var copyState = QuantumState(numQubits: self.numQubits)
        let zero = Complex(real: 0.0, imag: 0.0)
        var cloned = Array<Complex>(repeating: zero, count: self.numStates)
        for stateIndex in 0..<self.numStates {
            cloned[stateIndex] = self.amplitudes[stateIndex]
        }
        copyState.amplitudes = cloned
        return copyState
    }

    fn formatBasisKet(self, _ stateIndex: int) -> String {
        var bits = "|"
        var offset = 0
        while offset < self.numQubits {
            let bitPos = (self.numQubits - 1) - offset
            let bit = (stateIndex >> bitPos) & 1
            bits.append(bit.describe())
            offset += 1
        }
        bits.append(">")
        return bits
    }

    fn describeSignificantStates(self, _ minProb: double) -> String {
        var out = "QuantumState(\(self.numQubits) qubits, \(self.numStates) basis states, norm=\(self.totalProbability().formatted(decimals: 6))):\n"
        for stateIndex in 0..<self.numStates {
            let amp = self.amplitudes[stateIndex]
            let prob = amp.normSquared()
            if prob >= minProb {
                let ket = self.formatBasisKet(stateIndex)
                let pct = (prob * 100.0).formatted(decimals: 2)
                out.append("  \(ket) : amp=\(amp.describe())  prob=\(prob.formatted(decimals: 4)) (\(pct)%)\n")
            }
        }
        return out
    }
}

implementation Describable for QuantumState {
    fn describe(self) -> String {
        return self.describeSignificantStates(0.0001)
    }
}
